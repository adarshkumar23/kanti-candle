generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  imageUrl    String?
  category    String   @default("Signature")
  stock       Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  status      String   @default("PENDING")
  totalPrice  Float
  customerName String?
  email       String?
  itemsData   String   // JSON stringified items
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiDesign {
  id          String   @id @default(cuid())
  prompt      String
  imageUrl    String
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
}

model Discount {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  type          String   @default("percentage") // "percentage" or "fixed"
  value         Float    // percentage (0-100) or fixed INR amount
  minOrder      Float    @default(0) // minimum order value to apply
  maxUses       Int      @default(0) // 0 = unlimited
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  appliesToAll  Boolean  @default(true) // applies to all products
  categories    String?  // comma-separated category names if not appliesToAll
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
